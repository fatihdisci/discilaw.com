# Keystatic Cloud (primary)
KEYSTATIC_CLOUD_PROJECT=replace-with-your-keystatic-cloud-project-id

# Supabase
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-your-supabase-publishable-key
# Keep /portal on discilaw.com. Set to / when moving the app to portal.discilaw.com.
PUBLIC_PORTAL_BASE_PATH=/portal

# Supabase Edge Function secrets (do not add these to PUBLIC_* variables)
# SUPABASE_URL and SUPABASE_SERVICE_ROLE_KEY are provided by Supabase when deployed.
PORTAL_SITE_URL=https://discilaw.com
PORTAL_ALLOWED_ORIGIN=https://discilaw.com
PORTAL_REDIRECT_PATH=/portal

# Optional fallback: Keystatic GitHub mode
# (Only needed if you later switch storage.kind to "github")
KEYSTATIC_SECRET=replace-with-a-random-secret-at-least-32-characters
KEYSTATIC_GITHUB_CLIENT_ID=replace-with-github-oauth-app-client-id
KEYSTATIC_GITHUB_CLIENT_SECRET=replace-with-github-oauth-app-client-secret
